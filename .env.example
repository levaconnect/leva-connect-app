# LevaConnect Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Database (Neon PostgreSQL)
# ============================================================================
# Get this from your Neon dashboard: https://console.neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# ============================================================================
# JWT Secrets
# ============================================================================
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token expires in 15 minutes, refresh token in 7 days
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# Admin Configuration
# ============================================================================
# Admin account created during seeding
# Change these before deploying to production!
ADMIN_EMAIL=admin@levaconnect.dev
ADMIN_PASSWORD=Admin@123456

# ============================================================================
# Server Configuration
# ============================================================================
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=15 minutes

# ============================================================================
# Mobile App Configuration
# ============================================================================
# For iOS Simulator: http://localhost:4000
# For Android Emulator: http://10.0.2.2:4000
# For physical device on same WiFi: http://YOUR_COMPUTER_IP:4000
# Find your IP with: ifconfig | grep "inet " | grep -v 127.0.0.1
EXPO_PUBLIC_API_URL=http://localhost:4000

# ============================================================================
# Optional: Email Service (for password reset)
# ============================================================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=LevaConnect <noreply@levaconnect.app>